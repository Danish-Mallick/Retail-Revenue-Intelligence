		sourceColumn: AOV

	measure 'Recorded Sales' = SUM(Sales[Revenue])
		lineageTag: 4753fc15-dcfd-486a-93de-68fe0b478596
		formatString: £#,0

	measure 'Invoices' = SUM(Sales[Orders])
		lineageTag: c234ce5b-a284-4e9e-8c6e-862554870a74
		formatString: #,0

	measure 'Average Order Value' = DIVIDE([Recorded Sales], [Invoices])
		lineageTag: fa13dec7-61a5-4d0e-b63c-7c90e8e84f41
		formatString: £#,0.00

	measure 'Later Month Buyer Sales' = SUM(Sales[ReturningLaterMonthRevenue])
		lineageTag: cf560fac-a5d2-493b-82d5-bf0a93c681f0
		formatString: £#,0

	measure 'Later Month Buyer Share' = DIVIDE([Later Month Buyer Sales], [Recorded Sales])
		lineageTag: e7b37bc0-e911-45d6-a2c5-cdea2d14b04a
		formatString: 0.0%

	partition Sales = m
		mode: import
		source =
				let
				    Contents = Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.GZip),
				    CSV = Csv.Document(Contents,[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(CSV,[PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"Month", type text},{"Country", type text},{"Revenue", type number},{"Orders", Int64.Type},{"ActiveCustomers", Int64.Type},{"Units", Int64.Type},{"Year", Int64.Type},{"FirstObservedMonthRevenue", type number},{"ReturningLaterMonthRevenue", type number},{"AOV", type number}})
				in
				    Typed

	annotation PBI_ResultType = Table
