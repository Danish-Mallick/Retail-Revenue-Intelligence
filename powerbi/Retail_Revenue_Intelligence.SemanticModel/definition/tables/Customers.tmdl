table Customers
	lineageTag: 4f0c099e-ce62-426e-9382-b80a01bee6ae

	column CustomerKey
		dataType: int64
		lineageTag: 3decc195-b154-47a5-a71a-5986202b31de
		summarizeBy: none
		sourceColumn: CustomerKey

	column Revenue
		dataType: double
		lineageTag: f5c388c9-b874-42a9-914a-ad6737726f8b
		summarizeBy: sum
		sourceColumn: Revenue

	column Orders
		dataType: int64
		lineageTag: d154a678-d272-4dae-95d5-2a92a1ef80b0
		summarizeBy: none
		sourceColumn: Orders

	column FirstObservedMonth
		dataType: string
		lineageTag: cdc4da9d-90fa-4606-94dc-be4c5cc4d378
		summarizeBy: none
		sourceColumn: FirstObservedMonth

	column RecencyDays
		dataType: int64
		lineageTag: c4ee19ca-8813-435e-b7b9-16dcb060d289
		summarizeBy: none
		sourceColumn: RecencyDays

	column Country
		dataType: string
		lineageTag: c599406f-08a6-46ff-8038-159036d5c49a
		summarizeBy: none
		sourceColumn: Country

	column Segment
		dataType: string
		lineageTag: 78f1405a-5486-4934-89b1-892623a02800
		summarizeBy: none
		sourceColumn: Segment

	measure 'Customer Count' = COUNTROWS(Customers)
		lineageTag: 03184a79-b4a4-4daf-acd9-4959ca5b2ec9
		formatString: #,0

	measure 'Multiple Order Buyers' = CALCULATE([Customer Count], KEEPFILTERS(Customers[Orders] >= 2))
		lineageTag: 4f048a8b-0de3-4093-85d0-864e2206749c
		formatString: #,0

	measure 'Multi Order Buyer Sales Share' = DIVIDE(CALCULATE(SUM(Customers[Revenue]), KEEPFILTERS(Customers[Orders] >= 2)),SUM(Customers[Revenue]))
		lineageTag: 691cfe11-9623-43ef-8de2-a2d075d8c2ce
		formatString: 0.0%

	measure 'Champion Sales Share' = DIVIDE(CALCULATE(SUM(Customers[Revenue]),KEEPFILTERS(Customers[Segment] = "Champions")),SUM(Customers[Revenue]))
		lineageTag: c0f5aaa1-c961-4ec8-a218-74724036077a
		formatString: 0.0%

	measure 'Customer Sales' = SUM(Customers[Revenue])
		lineageTag: 403571fe-2970-4a61-99cc-80c482c6c421
		formatString: £#,0

	partition Customers = m
		mode: import
		source =
				let
				    Contents = Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.GZip),
				    CSV = Csv.Document(Contents,[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(CSV,[PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"CustomerKey", Int64.Type},{"Revenue", type number},{"Orders", Int64.Type},{"FirstObservedMonth", type text},{"RecencyDays", Int64.Type},{"Country", type text},{"Segment", type text}})
				in
				    Typed

	annotation PBI_ResultType = Table
